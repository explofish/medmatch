# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobplatform
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Configuration
# Provider: resend, sendgrid, ses, mailgun, or smtp
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@medmatch.de
EMAIL_FROM_NAME=MedMatch
EMAIL_RATE_LIMIT=60

# Resend (recommended - https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# SendGrid (alternative - https://sendgrid.com)
# SENDGRID_API_KEY=SG.your_api_key_here

# AWS SES (alternative - requires AWS credentials)
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Mailgun (alternative - https://mailgun.com)
# MAILGUN_API_KEY=key-your_api_key
# MAILGUN_DOMAIN=mg.medmatch.de

# SMTP (fallback)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
