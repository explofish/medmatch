# MedMatch Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_BODY=false

# ============================================
# CORS Configuration (Production)
# ============================================
# ALLOWED_ORIGINS=https://medmatch.de,https://www.medmatch.de

# ============================================
# Database (Production - PostgreSQL)
# ============================================
# DATABASE_URL=postgresql://user:password@host:5432/medmatch

# ============================================
# Security (Production)
# ============================================
# JWT_SECRET=your-256-bit-secret-here-minimum-32-characters-long
# JWT_EXPIRES_IN=24h
# BCRYPT_ROUNDS=12

# ============================================
# Rate Limiting (Production)
# ============================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# External Services (Optional)
# ============================================
# SENTRY_DSN=https://...@sentry.io/...
# NEW_RELIC_LICENSE_KEY=...
# REDIS_URL=redis://localhost:6379

# ============================================
# Email Configuration (Optional)
# ============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
# EMAIL_FROM=noreply@medmatch.de
