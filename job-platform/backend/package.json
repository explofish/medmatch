{
  "name": "medmatch-backend",
  "version": "1.1.0",
  "description": "MedMatch Job Platform Backend - SQLite for local development",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "NODE_ENV=test jest --testTimeout=10000 --forceExit",
    "test:watch": "NODE_ENV=test jest --watch",
    "seed": "node scripts/seed.js",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:detailed": "node scripts/benchmark.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "health": "curl -s http://localhost:3001/api/health | jq ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": "18.x"
  }
}
