  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set default values for variables if not already set",
          "if (!pm.environment.get('candidateId')) {",
          "    pm.environment.set('candidateId', '1');",
          "}",
          "if (!pm.environment.get('employerId')) {",
          "    pm.environment.set('employerId', '1');",
          "}",
          "if (!pm.environment.get('jobId')) {",
          "    pm.environment.set('jobId', '1');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Base URL for the API"
    },
    {
      "key": "candidateId",
      "value": "",
      "type": "string",
      "description": "ID of the test candidate"
    },
    {
      "key": "employerId",
      "value": "",
      "type": "string",
      "description": "ID of the test employer"
    },
    {
      "key": "jobId",
      "value": "",
      "type": "string",
      "description": "ID of the test job"
    }
  ]
