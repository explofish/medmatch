generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          UserRole  @default(GRADUATE)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts     Account[]
  sessions     Session[]
  graduateProfile GraduateProfile?
  employerProfile EmployerProfile?
  jobs         Job[]        @relation("JobAuthor")
  applications Application[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

enum UserRole {
  GRADUATE
  EMPLOYER
  ADMIN
}

model GraduateProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  phone          String?
  location       String?
  specialization String?
  graduationYear Int?     @map("graduation_year")
  university     String?
  bio            String?
  skills         String?
  cvUrl          String?  @map("cv_url")
  preferences    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("graduate_profiles")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  description String?
  website     String?
  location    String?
  industry    String?
  logoUrl     String?  @map("logo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employers EmployerProfile[]
  jobs      Job[]

  @@map("companies")
}

model EmployerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  companyId   String?  @map("company_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phone       String?
  title       String?
  department  String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])

  @@map("employer_profiles")
}

model Job {
  id              String     @id @default(cuid())
  authorId        String     @map("author_id")
  companyId       String?    @map("company_id")
  title           String
  description     String
  requirements    String?
  specialization  String?
  location        String?
  salaryMin       Int?       @map("salary_min")
  salaryMax       Int?       @map("salary_max")
  salaryCurrency  String     @default("EUR") @map("salary_currency")
  employmentType  String     @default("full_time") @map("employment_type")
  experienceLevel String?    @map("experience_level")
  status          JobStatus  @default(ACTIVE)
  expiresAt       DateTime?  @map("expires_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  author      User          @relation("JobAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  company     Company?      @relation(fields: [companyId], references: [id])
  applications Application[]

  @@map("jobs")
}

enum JobStatus {
  ACTIVE
  PAUSED
  CLOSED
  FILLED
}

model Application {
  id            String              @id @default(cuid())
  jobId         String              @map("job_id")
  graduateId    String              @map("graduate_id")
  applicantId   String              @map("applicant_id")
  coverLetter   String?             @map("cover_letter")
  status        ApplicationStatus   @default(PENDING)
  reviewedAt    DateTime?           @map("reviewed_at")
  notes         String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  job       Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  graduate  GraduateProfile @relation(fields: [graduateId], references: [id], onDelete: Cascade)
  applicant User            @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([jobId, graduateId])
  @@map("applications")
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

// Monitoring and Logging Models

model RequestLog {
  id          String   @id @default(cuid())
  method      String
  path        String
  query       String?
  statusCode  Int      @map("status_code")
  responseTimeMs Int    @map("response_time_ms")
  userAgent   String?  @map("user_agent")
  referrer    String?
  ip          String?
  requestId   String   @map("request_id")
  userId      String?  @map("user_id")
  errorId     String?  @map("error_id")
  timestamp   DateTime @default(now())

  @@index([timestamp])
  @@index([path])
  @@index([statusCode])
  @@index([requestId])
  @@map("request_logs")
}

model ErrorLog {
  id          String   @id @default(cuid())
  requestId   String?  @map("request_id")
  message     String
  stack       String?
  code        String?
  path        String?
  method      String?
  userId      String?  @map("user_id")
  context     String?  // JSON string with additional context
  severity    ErrorSeverity @default(ERROR)
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([severity])
  @@index([resolvedAt])
  @@map("error_logs")
}

enum ErrorSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

model ApiMetrics {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  hour        Int      @default(0)
  
  // Request counts
  totalRequests   Int @default(0) @map("total_requests")
  successfulRequests Int @default(0) @map("successful_requests")
  errorRequests   Int @default(0) @map("error_requests")
  
  // Response times (in ms)
  totalResponseTimeMs Int @default(0) @map("total_response_time_ms")
  avgResponseTimeMs   Int @default(0) @map("avg_response_time_ms")
  maxResponseTimeMs   Int @default(0) @map("max_response_time_ms")
  
  // Error breakdown (stored as JSON string)
  errorTypes      String? @map("error_types") // {"500": 5, "404": 2, ...}
  
  // Endpoint stats (stored as JSON string)
  endpointStats   String? @map("endpoint_stats") // {"/api/auth/register": 10, ...}
  
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([date, hour])
  @@index([date])
  @@map("api_metrics")
}

model HealthCheckLog {
  id          String   @id @default(cuid())
  type        String   // 'basic' or 'deep'
  status      String   // 'healthy' or 'unhealthy'
  responseTimeMs Int  @map("response_time_ms")
  details     String?  // JSON string with check details
  error       String?
  timestamp   DateTime @default(now())

  @@index([timestamp])
  @@index([type])
  @@index([status])
  @@map("health_check_logs")
}
