generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          UserRole  @default(GRADUATE)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts     Account[]
  sessions     Session[]
  graduateProfile GraduateProfile?
  employerProfile EmployerProfile?
  jobs         Job[]        @relation("JobAuthor")
  applications Application[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

enum UserRole {
  GRADUATE
  EMPLOYER
  ADMIN
}

model GraduateProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  phone          String?
  location       String?
  specialization String?
  graduationYear Int?     @map("graduation_year")
  university     String?
  bio            String?
  skills         String?
  cvUrl          String?  @map("cv_url")
  preferences    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("graduate_profiles")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  description String?
  website     String?
  location    String?
  industry    String?
  logoUrl     String?  @map("logo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employers EmployerProfile[]
  jobs      Job[]

  @@map("companies")
}

model EmployerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  companyId   String?  @map("company_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phone       String?
  title       String?
  department  String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])

  @@map("employer_profiles")
}

model Job {
  id              String     @id @default(cuid())
  authorId        String     @map("author_id")
  companyId       String?    @map("company_id")
  title           String
  description     String
  requirements    String?
  specialization  String?
  location        String?
  salaryMin       Int?       @map("salary_min")
  salaryMax       Int?       @map("salary_max")
  salaryCurrency  String     @default("EUR") @map("salary_currency")
  employmentType  String     @default("full_time") @map("employment_type")
  experienceLevel String?    @map("experience_level")
  status          JobStatus  @default(ACTIVE)
  expiresAt       DateTime?  @map("expires_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  author      User          @relation("JobAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  company     Company?      @relation(fields: [companyId], references: [id])
  applications Application[]

  @@map("jobs")
}

enum JobStatus {
  ACTIVE
  PAUSED
  CLOSED
  FILLED
}

model Application {
  id            String              @id @default(cuid())
  jobId         String              @map("job_id")
  graduateId    String              @map("graduate_id")
  applicantId   String              @map("applicant_id")
  coverLetter   String?             @map("cover_letter")
  status        ApplicationStatus   @default(PENDING)
  reviewedAt    DateTime?           @map("reviewed_at")
  notes         String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  job       Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  graduate  GraduateProfile @relation(fields: [graduateId], references: [id], onDelete: Cascade)
  applicant User            @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([jobId, graduateId])
  @@map("applications")
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  REJECTED
  ACCEPTED
  WITHDRAWN
}
