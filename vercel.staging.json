{
  "version": 2,
  "name": "medmatch-demo",
  "builds": [
    {
      "src": "landing-page/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://medmatch-api-demo.onrender.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "landing-page/$1"
    }
  ],
  "buildCommand": "cd landing-page && npm run build",
  "outputDirectory": "landing-page/dist",
  "env": {
    "BACKEND_URL": "https://medmatch-api-demo.onrender.com",
    "NEXT_PUBLIC_BACKEND_URL": "https://medmatch-api-demo.onrender.com",
    "NEXT_PUBLIC_PLAUSIBLE_DOMAIN": "medmatch-demo.vercel.app"
  }
}
