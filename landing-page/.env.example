# Ad Tracking Environment Variables
# Copy this to .env.local and fill in actual values from ad accounts

# LinkedIn Campaign Manager
# Get from: business.linkedin.com → Campaign Manager → Account Assets → Insight Tag
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=PLACEHOLDER
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=PLACEHOLDER

# Google Ads Conversion Tracking
# Get from: ads.google.com → Tools & Settings → Conversions → New Conversion Action
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=PLACEHOLDER
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=PLACEHOLDER

# Google Analytics 4 (if not already configured)
# Get from: analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=PLACEHOLDER

# Plausible Analytics (already configured)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=medmatch.de
